{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci"
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "numReplicas": 1
  },
  "service": {
    "rootDir": "server",
    "envs": {
      "PORT": {
        "value": "8080"
      },
      "QUOTE_PROVIDER": {
        "value": "rapid"
      },
      "RAPID_API_KEY": {
        "generator": "UNKNOWN_VALUE"
      },
      "GEN_USD_RATE": {
        "value": "1.5"
      }
    }
  }
}