# Copy to `.env` at the repo root and fill with REAL values. Never commit `.env`.
# Split wiring:
#   - Quote server (Expedia): copy `server/.env.example` -> `server/.env`.
#   - Frontend (wallet + contract): copy `frontend/.env.example` -> `frontend/.env`.

# ---- GenLayer (Studio) ----
# RPC for the on-chain client. Studionet: https://studio.genlayer.com/api
GENLAYER_RPC=https://studio.genlayer.com/api

# Deployer / admin private key. PLACEHOLDER — replace before any real
# deployment. Never store a mainnet key here.
GENLAYER_PRIVATE_KEY=REPLACE_WITH_PLACEHOLDER_KEY

# Contract address once deployed (used by the frontend live client).
GENLAYER_CONTRACT_ADDRESS=

# ---- Server-side rate limit for the /api/quote proxy (requests per minute) ----
QUOTE_PROXY_RATE_LIMIT=30