# Copy to server/.env and fill with REAL values. Never commit .env.

# ---- Single fare provider (no fallback, no demo) ----
# QUOTE_PROVIDER picks the ONE source of real fares:
#   rapid       -> RapidAPI "google-flights2" (real Google Flights fares).
#                  Free RapidAPI account: https://rapidapi.com -> search
#                  "google-flights2" -> subscribe (free tier) -> copy the
#                  X-RapidAPI-Key shown on the API page -> RAPID_API_KEY.
#   kiwi        -> Kiwi.com Tequila (https://tequila.kiwi.com). NOTE: new
#                  self-service signup is invitation-only since 2024; keep this
#                  only if you already have a key.
#   omkarcloud  -> OmkarCloud Expedia scraper (https://www.omkar.cloud/auth/sign-up).
#                  Requires OMKAR_API_KEY.
# While the chosen provider is down the server returns a clear 503 (or a stale,
# clearly-marked cached quote) — it never fabricates or substitutes a source.
QUOTE_PROVIDER=rapid

# RapidAPI google-flights2 key.
RAPID_API_KEY=

# Kiwi.com Tequila API key.
KIWI_API_KEY=

# OmkarCloud Expedia Scraper API key (free tier: 100 requests/month).
OMKAR_API_KEY=

# Optional host overrides. Defaults shown below.
# RAPID_API_HOST=google-flights2.p.rapidapi.com
# KIWI_BASE_URL=https://tequila-api.kiwi.com
# OMKAR_BASE_URL=https://expedia-scraper.omkar.cloud

# GEN/USD pricing. Set a manual rate as the reliable fallback; the server also
# tries CoinGecko (`COINGECKO_TOKEN_IDS`) first, which today returns nothing for
# GEN. GEN price = 1 GEN in USD.
GEN_USD_RATE=1.5
# COINGECKO_TOKEN_IDS=genlayer

# Server port + caches + rate limit.
PORT=8080
QUOTE_TTL_MS=1800000
GEN_TTL_MS=300000
QUOTE_PROXY_RATE_LIMIT=30

# Server-only secret for HMAC reservation refs + operator overrides.
# NEVER stored on-chain — the contract holds no credentials. Also gates the
# operator override endpoint (Authorization: Bearer <PNR_SECRET or OPERATOR_SECRET>).
PNR_SECRET=

# Real booking-provider transaction: point BOOKING_PROVIDER_URL at any HTTP
# server you control that issues reservation references. When set, /api/reserve
# creates the reservation via that provider and returns its locator (e.g.
# `{locator:"ABC123", flightIata:"AF123"}`); otherwise the ref is an HMAC of
# the trip parameters (still unforgeable without PNR_SECRET).
# BOOKING_PROVIDER_URL=
# BOOKING_PROVIDER_API_KEY=

# Independent carrier-status source for refund evidence (Aviationstack):
# When set, /provider-status enriches the status with flight_status from an
# unaffiliated third-party API. Without it the endpoint degrades to the same
# date-rule status /status uses.