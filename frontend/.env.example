# Copy to frontend/.env for live on-chain + wallet mode. Never commit .env.

# Studionet (hosted dev env). RPC details: https://docs.genlayer.com/developers/networks
VITE_GENLAYER_RPC=https://studio.genlayer.com/api

# Contract address once deployed (from GenLayer Studio). When set, the client
# is "live": quotes come from the /api/quote proxy and writes need a wallet.
VITE_GENLAYER_CONTRACT_ADDRESS=

# Chain id for wallet switching (Studionet default 61999). Leave blank unless you override.
VITE_GENLAYER_CHAIN_ID=61999

# WalletConnect Project ID - free at https://cloud.walletconnect.com
# Leave blank to fall back to an injected wallet extension (Rabby/MetaMask).
VITE_WC_PROJECT_ID=

# Public quote server origin (e.g. https://travity-server.onrender.com). When set,
# /api/quote is fetched from that host (the deployed Express server). Leave blank
# to use the Vite dev proxy (/api -> http://127.0.0.1:8080) in local development.
#
# ALSO the on-chain feed root: the owner "Set feed URL" control on Home calls
# set_feed_url with exactly this value, and GenLayer validators fetch /quote +
# /status from it. Must be a public HTTPS origin for consensus to work.
VITE_QUOTE_API=

# Contract owner address. When a connected wallet matches (case-insensitive),
# Home shows the owner "Contract feed" panel that can call set_feed_url. Leave
# blank to keep the admin panel hidden.
VITE_GENLAYER_OWNER_ADDRESS=